{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "cppFlags": ""
    }
  },
  "targets": [
    {
      "name": "default",
      "config": {
        "buildOption": {
          "externalNativeOptions": { "abiFilters": ["arm64-v8a"] },
          "nativeLib": {
            "filter": { "excludes": ["**/x86_64/**", "**/armeabi-v7a/**"] }
          }
        }
      }
    },
    {
      "name": "emulator",
      "config": {
        "buildOption": {
          "externalNativeOptions": { "abiFilters": ["x86_64"] },
          "nativeLib": {
            "filter": { "excludes": ["**/arm64-v8a/**", "**/armeabi-v7a/**"] }
          }
        }
      }
    },
    { "name": "ohosTest" }
  ]
}

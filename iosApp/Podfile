platform :ios, '15.0'

target 'iosApp' do
  # JPush 是 Objective-C 静态库，通过 Bridging Header 桥接到 Swift；
  # 不开启 use_frameworks!，避免与 KMP 生成的静态 ComposeApp.framework 混用产生 link 异常。
  pod 'JPush'
end

# Pods xcconfig 与 user project 后置处理：
# 1) 反向引入 Config.xcconfig（由 updateAppleBuildVersion gradle 任务从 Config.xcconfig.template 注入业务变量），
#    使 baseConfiguration 指向 Pods xcconfig 时，业务变量与 Bridging Header / search paths 仍生效。
#    路径解析以 Pods xcconfig 自身位置为基准：iosApp/Pods/Target Support Files/Pods-iosApp/ → iosApp/Configuration/。
# 2) 从 OTHER_LDFLAGS 中移除 -l"Pods-iosApp"，并从 iosApp.xcodeproj 中删除 libPods-iosApp.a 相关引用。
#    Xcode 16 同步文件夹格式 (PBXFileSystemSynchronizedRootGroup) 与 CocoaPods 1.16.2 不兼容，
#    pod install 未向 iosApp.xcodeproj 写入对 Pods.xcodeproj 的子项目引用与 PBXTargetDependency，
#    导致 CI 干净环境下 Pods-iosApp dummy 静态库不会被构建，linker 找不到 libPods-iosApp.a；
#    但 pod install 仍会把 libPods-iosApp.a 加进 main app 的 Frameworks build phase，引发 link 失败。
#    项目已通过 Config.xcconfig 的 LIBRARY_SEARCH_PATHS 直接指向 JCore/JPush xcframework 内的 slice，
#    并由 Pods xcconfig 注入 -lJCore -lJPush -ObjC 完成真实库链接，
#    Pods-iosApp 在此场景下不承载代码，断掉对它的全部链接路径不影响运行。
post_install do |installer|
  include_line = '#include "../../../Configuration/Config.xcconfig"'
  pattern = File.join(installer.config.installation_root, 'Pods/Target Support Files/Pods-*/Pods-*.xcconfig')
  Dir.glob(pattern).each do |xcconfig_path|
    content = File.read(xcconfig_path)
    # 清理之前可能写错的 include 行（路径不对或用 #include? 静默失败的版本）
    cleaned = content.lines.reject { |l| l.strip.start_with?('#include') && l.include?('Configuration/Config.xcconfig') }.join
    # 移除 OTHER_LDFLAGS 中的 -l"Pods-iosApp" / -lPods-iosApp（带或不带引号，前后须为空白或行尾）
    cleaned = cleaned.gsub(/\s+-l\s*"?Pods-iosApp"?(?=\s|$)/, '')
    new_content = "#{include_line}\n#{cleaned}"
    next if content == new_content
    File.write(xcconfig_path, new_content)
    puts "[Podfile] Patched #{File.basename(xcconfig_path)}"
  end

  # 清理 main app 工程中 libPods-iosApp.a 的全部痕迹：
  # PBXBuildFile / PBXFileReference / Frameworks build phase 中的引用。
  require 'xcodeproj'
  user_project_path = File.join(installer.config.installation_root, 'iosApp.xcodeproj')
  user_project = Xcodeproj::Project.open(user_project_path)
  dirty = false
  user_project.objects.dup.each do |obj|
    case obj.isa
    when 'PBXBuildFile'
      ref = obj.file_ref
      if ref && ref.respond_to?(:path) && ref.path.to_s.end_with?('libPods-iosApp.a')
        obj.remove_from_project
        dirty = true
      end
    when 'PBXFileReference'
      if obj.path.to_s.end_with?('libPods-iosApp.a')
        obj.remove_from_project
        dirty = true
      end
    end
  end
  if dirty
    user_project.save
    puts '[Podfile] Stripped libPods-iosApp.a references from iosApp.xcodeproj'
  end
end

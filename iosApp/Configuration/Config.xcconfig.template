TEAM_ID=

PRODUCT_NAME=XhuTimetable
PRODUCT_BUNDLE_IDENTIFIER=vip.mystery0.xhu.timetable.XhuTimetable$(TEAM_ID)

CURRENT_PROJECT_VERSION={gitVersionCode}
MARKETING_VERSION={appVersionName}

JPUSH_APPKEY={releasePushAppKey}
JPUSH_APPKEY[config=Debug]={debugPushAppKey}
JPUSH_CHANNEL={pushChannel}

// JPush 6.x 为 Objective-C 静态库，通过 Bridging Header 暴露给 Swift
SWIFT_OBJC_BRIDGING_HEADER = iosApp/iosApp-Bridging-Header.h

// JCore / JPush xcframework 直接 vendor 在 iosApp/Frameworks/，不再走 CocoaPods，
// 以规避 CocoaPods 1.16.2 与 Xcode 16 PBXFileSystemSynchronizedRootGroup 的不兼容。
HEADER_SEARCH_PATHS = $(inherited) "${SRCROOT}/Frameworks/jcore-ios-5.4.0.xcframework/ios-arm64/Headers" "${SRCROOT}/Frameworks/jpush-ios-6.1.0.xcframework/ios-arm64/Headers"
HEADER_SEARCH_PATHS[sdk=iphonesimulator*] = $(inherited) "${SRCROOT}/Frameworks/jcore-ios-5.4.0.xcframework/ios-arm64_x86_64-simulator/Headers" "${SRCROOT}/Frameworks/jpush-ios-6.1.0.xcframework/ios-arm64_x86_64-simulator/Headers"

LIBRARY_SEARCH_PATHS = $(inherited) "${SRCROOT}/Frameworks/jcore-ios-5.4.0.xcframework/ios-arm64" "${SRCROOT}/Frameworks/jpush-ios-6.1.0.xcframework/ios-arm64"
LIBRARY_SEARCH_PATHS[sdk=iphonesimulator*] = $(inherited) "${SRCROOT}/Frameworks/jcore-ios-5.4.0.xcframework/ios-arm64_x86_64-simulator" "${SRCROOT}/Frameworks/jpush-ios-6.1.0.xcframework/ios-arm64_x86_64-simulator"

// -ObjC：让 OC category（JPush 内部用到）正确合并；
// -lJCore -lJPush：链接 vendor 的静态库；
// -Wl,-U,_sqlite3_load_extension：iOS SDK libsqlite3 编译时禁用了该符号，
//   androidx.sqlite cinterop 仅引用未调用，告诉 linker 容忍 undefined。
OTHER_LDFLAGS = $(inherited) -ObjC -lJCore -lJPush -Wl,-U,_sqlite3_load_extension
